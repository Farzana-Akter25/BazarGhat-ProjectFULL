APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Checkout phone OTP delivery: "log" (free, writes to the log) or "alpha" (real
# SMS via sms.net.bd). SMS_EXPOSE_CODE returns the code in the API response and
# is ignored unless the driver is "log".
SMS_DRIVER=log
SMS_EXPOSE_CODE=true
SMS_TIMEOUT=10
ALPHA_SMS_API_KEY=
ALPHA_SMS_SENDER_ID=
ALPHA_SMS_URL=https://api.sms.net.bd/sendsms

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SSLCommerz payment gateway. The store credentials stay server-side — they are
# read only by App\Services\SslCommerzService and never reach the frontend.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SESSION_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# Refund initiation and refund-status lookup. Same SSLCommerz endpoint, called
# with different parameters. Point both at the live host in production:
# https://securepay.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php
SSLCOMMERZ_REFUND_URL=https://sandbox.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php
SSLCOMMERZ_REFUND_STATUS_URL=https://sandbox.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php

# Where the gateway sends the customer back to, and the public base URL it posts
# its success/fail/cancel/IPN callbacks to.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
